{
  "name": "holler-mobile",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "check:env": "node scripts/check-client-env.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "node scripts/check-client-env.mjs && node scripts/check-version.mjs && tsc -p tsconfig.json --noEmit && vite build",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit",
    "preview": "vite preview",
    "cap:sync": "npm run build && npx cap sync",
    "cap:sync:ios": "npm run build && npx cap sync ios",
    "cap:sync:android": "npm run build && npx cap sync android",
    "cap:assets": "node scripts/make-assets.mjs && npx capacitor-assets generate --ios --android --assetPath assets",
    "ios": "npx cap open ios",
    "android": "npx cap open android",
    "check:version": "node scripts/check-version.mjs",
    "check:dist": "node scripts/check-dist-gating.mjs",
    "check:sync": "node scripts/check-sync.mjs"
  },
  "dependencies": {
    "@capacitor-firebase/messaging": "8.6.0",
    "@capacitor/android": "8.6.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.6.2",
    "@capacitor/ios": "8.6.2",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "@capawesome/capacitor-apple-sign-in": "0.1.5",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@revenuecat/purchases-capacitor": "14.1.2",
    "@supabase/supabase-js": "2.119.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@capacitor/assets": "4.0.0",
    "@capacitor/cli": "8.6.2",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
