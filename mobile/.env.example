# Public build settings for the Holler app. Copy to .env.production.local on the Mac that builds.
# Everything here is compiled into the app and readable by anyone: public values only.
# `npm run build` refuses to build when a value looks secret (scripts/check-client-env.mjs).

# Website and API.
VITE_API_BASE=https://localholler.com

# Supabase: the project URL and the ANON / publishable key (never the service role or a secret key).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# RevenueCat PUBLIC app-specific SDK keys (appl_... and goog_...). Never the secret sk_ key.
VITE_REVENUECAT_IOS_KEY=
VITE_REVENUECAT_ANDROID_KEY=

# Flags: only the exact text "true" turns one on.
# Apple off hides BOTH social buttons (App Store guideline 4.8).
VITE_APPLE_SIGN_IN=false
VITE_GOOGLE_SIGN_IN=false
# Turn on after GoogleService-Info.plist and google-services.json are in place (RELEASE.md, step F).
VITE_PUSH_ENABLED=false
# Owner decision, leave off: a "Subscribe on the web" link on the iOS paywall for US App Store accounts only.
VITE_IOS_EXTERNAL_PURCHASE_LINK=false
