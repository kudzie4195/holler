# Holler environment. Copy to .env.local for local work; on Vercel add each one under Settings > Environment Variables.
# Every key from lib/env.ts (ENV_KEYS) is listed. Never commit real values.
# REQUIRED keys: the app does not work without them. RECOMMENDED: needed for a real launch. OPTIONAL: a feature turns off without it.

# ---------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------

# REQUIRED. Supabase project URL (Project Settings > API). Shared project: Holler only touches tables named holler_*.
NEXT_PUBLIC_SUPABASE_URL=

# REQUIRED. Supabase anon (publishable) key. Safe for the browser; row level security protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# REQUIRED. Supabase service role key. Server only. Never expose it, never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# REQUIRED. Public https URL of the deployed site, no trailing slash. Used for canonical URLs, sitemap, emails and Stripe redirects.
NEXT_PUBLIC_SITE_URL=https://holler.example

# REQUIRED. Long random string (openssl rand -hex 32): authenticates /api/cron/* and signs email links. Set once, rotating breaks emailed links.
CRON_SECRET=

# ---------------------------------------------------------------------------
# RECOMMENDED for launch
# ---------------------------------------------------------------------------

# RECOMMENDED. Resend API key. Without it no email is sent (alerts, verify, password reset, health report).
RESEND_API_KEY=

# RECOMMENDED. From address on a domain verified in Resend, like: Holler <alerts@yourdomain.com>. Unset means email is skipped on purpose.
EMAIL_FROM=

# RECOMMENDED. A monitored inbox. Used as reply-to on every email and shown on the Privacy and Terms pages.
SUPPORT_EMAIL=

# RECOMMENDED. Where the daily health email goes. Falls back to SUPPORT_EMAIL.
ADMIN_EMAIL=

# RECOMMENDED. Stripe secret key (sk_live_... for launch, sk_test_... to try it). Without it billing shows "opens soon".
STRIPE_SECRET_KEY=

# RECOMMENDED with Stripe. Signing secret (whsec_...) of the webhook endpoint https://<site>/api/stripe/webhook.
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# OPTIONAL: more data sources and features. A source without its key shows as "skipped(env)" and in the health email as not configured.
# That is not a failure: the smoke test prints a WARN line and still passes.
# Public wording follows the keys. The home page, /about, /llms.txt, the trade pages and the checker name a source or a signal type only
# when its key is set, and leave the sentence, list item, FAQ entry or example out when it is not:
#   people asking for a recommendation   needs BRAVE_SEARCH_API_KEY, SERPER_API_KEY, or both Bluesky keys. "Bluesky" is named only with both
#                                         Bluesky keys, "licensed search APIs" only with a Brave or Serper key.
#   big concerts, games and festivals     needs TICKETMASTER_API_KEY (Ticketmaster is named only with it)
#   SAM.gov bids                          needs SAM_API_KEY
# The home page example alert is always a storm report. Trades that receive nothing without a key (childcare and beauty, whose only
# source is people asking) show in onboarding and Settings last in their group as disabled "Coming soon" chips, and never count toward the
# five picks. They become selectable as soon as a people-asking key is set.
# Adding or removing any optional key needs a redeploy before the public pages change. The home page, /about and /llms.txt are built once
# at deploy time and read the keys then; onboarding and Settings read them on each request. On Vercel a changed variable only reaches a new
# deployment, so redeploy after every change.
# ---------------------------------------------------------------------------

# OPTIONAL. Vercel AI Gateway key for draft replies. On Vercel the platform token works without it. Without any, drafts use a plain template.
AI_GATEWAY_API_KEY=

# AI sorting step (/api/cron/ai, hourly at minute 4, migration 0014). It sorts new public records by trade and writes the short
# "Why it may matter" line on feed cards and in the digest. It runs on the Vercel AI Gateway with the key above (or the Vercel platform
# token). Without either, the step answers no_gateway_auth and the keyword rules alone decide the trades.
# OPTIONAL. Model id on the AI Gateway. Leave empty for the default, anthropic/claude-haiku-5.5.
AI_CLASSIFY_MODEL=

# At the cap the step stops for the month and one email goes to ADMIN_EMAIL; alerts keep going out with the keyword-rule trades.
# OPTIONAL. Hard monthly spend cap in US dollars for the AI step. Empty means 10.
AI_MONTHLY_CAP_USD=10

# OPTIONAL. Brave Search API key: "people asking for a recommendation" posts from web search.
BRAVE_SEARCH_API_KEY=

# OPTIONAL. Serper API key: the same feed from Serper. Steps aside when a Brave key is set.
SERPER_API_KEY=

# Bluesky needs BOTH keys below. Without both, the Bluesky source is skipped ("skipped(env)", listed as not configured in the health
# email), never an error. For each matched post Holler keeps the snippet, the link and the author's public handle.
# OPTIONAL. Bluesky handle of a free account (like name.bsky.social). Bluesky search needs a login.
BLUESKY_HANDLE=

# OPTIONAL. Bluesky app password for that account (Settings > Privacy and security > App passwords). Never the main account password.
BLUESKY_APP_PASSWORD=

# OPTIONAL. SAM.gov API key: federal bid opportunities.
SAM_API_KEY=

# OPTIONAL. Ticketmaster Discovery API key: big events this week.
TICKETMASTER_API_KEY=

# OPTIONAL. City open bids (San Francisco, Los Angeles, Baton Rouge) as Open bid cards. OFF unless set to 1, true, on or yes. Leave empty until the owner turns bids on.
HOLLER_BIDS_ENABLED=

# OPTIONAL. Atlanta-area agency bid pages read with Firecrawl (paid credits). OFF unless set to 1, true, on or yes. A separate switch from HOLLER_BIDS_ENABLED on purpose: turning on the city bids never starts Firecrawl spend. Firecrawl runs only when HOLLER_BIDS_ENABLED, this and FIRECRAWL_API_KEY are ALL set; with any one missing there is no Firecrawl call at all (the owner probe, `/api/admin/firecrawl-probe`, needs only the key and the Bearer secret).
HOLLER_LOCAL_BIDS_ENABLED=

# Firecrawl reads the Atlanta-area county and city bid pages as Open bid cards. Server only: never prefix the key with NEXT_PUBLIC_ and never
# log it. Docs: https://docs.firecrawl.dev
# OPTIONAL. Firecrawl API key.
FIRECRAWL_API_KEY=

# Firecrawl credit budget, in whole credits. Free plan = 1,000 credits a month (docs.firecrawl.dev/billing). Lower values only make it stricter.
# OPTIONAL. Most credits one scan run may spend. Default 24.
FIRECRAWL_RUN_CREDIT_CAP=
# OPTIONAL. Most credits Firecrawl may spend in one UTC day, counted from the ledger. Default 30.
FIRECRAWL_DAILY_CREDIT_CAP=
# OPTIONAL. Most credits Firecrawl may spend in one UTC month, counted from the ledger. Default 500 (half the free plan).
FIRECRAWL_MONTHLY_CREDIT_CAP=
# OPTIONAL. The account is never drawn below this many remaining credits (read live from Firecrawl). Default 100.
FIRECRAWL_MIN_REMAINING=
# OPTIONAL. Most credits the owner probe (GET /api/admin/firecrawl-probe) may spend in one UTC day, on top of the daily and monthly caps. Default 25.
FIRECRAWL_PROBE_DAILY_CAP=

# OPTIONAL. Socrata app token: higher rate limits for city open-data feeds. Works without it, slower under load.
SOCRATA_APP_TOKEN=

# IndexNow tells Bing and the other IndexNow search engines about city pages and weekly pages that got new records, and the key is served at
# /indexnow-key.txt. It needs NEXT_PUBLIC_SITE_URL set to the real public address. Without a key nothing is sent and that path returns 404.
# OPTIONAL. IndexNow key, 8 to 128 characters of letters, digits and dashes (for example the output of `openssl rand -hex 16`).
INDEXNOW_KEY=

# Resident service requests (/request) are on unless this is "0" (or "false"/"off"). With "0" the API answers 503 at once and the
# /request page shows a short "requests are paused" note after the next deploy (the page is built at deploy time). Closing, confirming
# and replying to requests already made keep working.
# OPTIONAL. Off switch for new resident requests. Leave empty (on) or set to 0 (paused).
REQUESTS_ENABLED=

# The mobile app's App Store and Google Play subscriptions reach Holler through RevenueCat. Type the same value into RevenueCat >
# Integrations > Webhooks > Authorization header (exactly, no "Bearer"). Without it /api/revenuecat/webhook answers 503.
# OPTIONAL. RevenueCat webhook shared secret, for example the output of `openssl rand -hex 32`.
REVENUECAT_WEBHOOK_SECRET=

# OPTIONAL. Set to 1 so App Store and Google Play sandbox purchases (TestFlight, App Review) give a plan. Leave empty after review.
REVENUECAT_ALLOW_SANDBOX=

# Push notifications for the mobile app go through Firebase Cloud Messaging. Paste the service account key JSON (or its base64).
# OPTIONAL. Firebase service account key for FCM HTTP v1. Without it no push is sent.
FIREBASE_SERVICE_ACCOUNT_JSON=
